generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Type {
  id          Int           @id @default(autoincrement())
  name        String        @unique
  pokemons    PokemonCard[] @relation("Pokemon_Type")
  PokemonCard PokemonCard[]
}

model PokemonCard {
  id         Int     @id @default(autoincrement())
  name       String  @unique
  pokedexId  Int     @unique
  typeId     Int
  type       Type    @relation(name: "Pokemon_Type", fields: [typeId], references: [id])
  lifePoints Int
  size       Float?
  weight     Float?
  imageUrl   String?
  Type       Type    @relation(fields: [typeId], references: [id])
}
